# Prom.ua seller Public API. Optional unless seller tools are used.
PROM_API_TOKEN=
PROM_API_BASE_URL=https://my.prom.ua/api/v1

# Seller safety switch. Write tools refuse to mutate Prom.ua unless explicitly enabled.
PROM_ALLOW_WRITES=false

# Public marketplace discovery: configure one provider.
BRAVE_API_KEY=
SEARXNG_URL=

# Buyer mode uses a persistent local Chromium profile.
PROM_BUYER_DATA_DIR=
PROM_BUYER_PROFILE_DIR=
PROM_BUYER_SAVED_SEARCHES_FILE=
PROM_BUYER_HEADLESS=false

# Favorites/cart changes are disabled by default. Checkout/payment is never automated.
PROM_BUYER_ALLOW_MUTATIONS=false
PROM_BUYER_ACTION_TIMEOUT_MS=15000
PROM_BUYER_PAGE_DELAY_MS=350

PROM_HTTP_TIMEOUT_MS=15000
