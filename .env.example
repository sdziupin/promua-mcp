# Prom.ua seller Public API. Optional unless seller tools are used.
PROM_API_TOKEN=
PROM_API_BASE_URL=https://my.prom.ua/api/v1

# Safety switch. Write tools refuse to mutate Prom.ua unless explicitly enabled.
PROM_ALLOW_WRITES=false

# Marketplace discovery: configure one provider.
BRAVE_API_KEY=
SEARXNG_URL=

# Optional request timeout in milliseconds.
PROM_HTTP_TIMEOUT_MS=15000
