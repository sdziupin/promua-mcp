# Prom.ua seller Public API.
# OPTIONAL: not needed for marketplace search.
# Set this only if you are a Prom.ua seller and want MCP tools to access/manage
# your own company cabinet: products, orders, clients, messages, groups,
# delivery/payment options, etc.
PROM_API_TOKEN=
PROM_API_BASE_URL=https://my.prom.ua/api/v1

# Seller safety switch. Write tools refuse to mutate seller data unless enabled.
PROM_ALLOW_WRITES=false

# Marketplace search needs no API keys:
# 1) direct Prom.ua SSR/JSON-LD search
# 2) DuckDuckGo HTML fallback if direct Prom parsing fails

# Local MCP state (saved searches only; no browser/session data).
PROM_DATA_DIR=
PROM_SAVED_SEARCHES_FILE=

PROM_HTTP_TIMEOUT_MS=15000
