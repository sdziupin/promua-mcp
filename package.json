{
  "name": "promua-mcp",
  "version": "0.3.1",
  "description": "Browser-free MCP server for direct Prom.ua marketplace search and seller Public API operations",
  "type": "module",
  "license": "MIT",
  "author": "Serhii Dziupin",
  "homepage": "https://github.com/sdziupin/promua-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdziupin/promua-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sdziupin/promua-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "promua",
    "prom.ua",
    "ukraine",
    "ecommerce",
    "shopping"
  ],
  "bin": {
    "promua-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.uk.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
